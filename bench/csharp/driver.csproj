<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# leg of the throughput suite. Not packaged, not published. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- A benchmark run against an unoptimised build measures the wrong
         program. bench.py builds this in Release, and this makes sure that a
         Debug build would still be optimised rather than quietly reporting a
         number several times too slow. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- The project next door by default, matching the conformance driver, so a
       released build can be asked for by property without a second copy. -->
  <ItemGroup Condition="'$(Released)' == ''">
    <ProjectReference Include="..\..\csharp\gpc\gpc.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Released)' != ''">
    <PackageReference Include="Ca.Pranavpatel.Algo.GridPointCode" Version="$(Released)" />
  </ItemGroup>

</Project>
