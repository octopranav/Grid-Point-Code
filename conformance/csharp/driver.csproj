<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# leg of the differential harness. Not packaged, not published. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The project next door by default. The released mode of compare.py passes
       a Released property to ask this same driver about what NuGet serves
       instead, so there is no second copy of the driver to keep in step. -->
  <ItemGroup Condition="'$(Released)' == ''">
    <ProjectReference Include="..\..\csharp\gpc\gpc.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Released)' != ''">
    <PackageReference Include="Ca.Pranavpatel.Algo.GridPointCode" Version="$(Released)" />
  </ItemGroup>

</Project>
