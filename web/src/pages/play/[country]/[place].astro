---
// One page for one place: its code, and how to give it.
//
// These exist for the reader who searches for a place and not for the format.
// Somebody typing "Manek Chowk" or "Toronto" is shown the code for it in the
// result's title. The page they land on starts from the address people use
// there today, a name and a city and then directions, and shows what a code
// adds to it: one for every stall and door, said in five characters after a
// name everyone already knows.
//
// Every figure on the page is computed here from the published package, not
// stored: the file behind it holds only a name and a point, so a page and the
// library cannot disagree about a code. That is also what makes each page
// different from the next in something more than its name, which is the line
// between a page for a place and a template with a name poured in.
import Base from '../../../layouts/Base.astro';
import CodeMark from '../../../components/CodeMark.astro';
import { GPC } from '@pranavpatel.ca/algo-gridpointcode';
import { CITY_LEVEL, resolve } from '../../../lib/levels';
import { PLACES, where, spoken, neighboursOf, type Place } from '../../../lib/places';

export function getStaticPaths() {
    return PLACES.map((place) => {
        const [country, slug] = place.slug.split('/');
        return { params: { country, place: slug }, props: { place } };
    });
}

const { place } = Astro.props as { place: Place };

const code = GPC.encode(place.lat, place.lon);
const plain = code.replace(/[^0-9A-Z]/g, '');
const [centreLatitude, centreLongitude] = GPC.decode(code);
const { levels } = resolve(place.lat, place.lon);

// A cell's north-south size holds everywhere; its east-west size is the
// equator's, narrowed by the cosine of the latitude it sits at.
const narrowing = Math.cos((centreLatitude * Math.PI) / 180);
const [, , northSouth, eastWestAtEquator] = GPC.cellDimensions(10);
const eastWest = eastWestAtEquator * narrowing;
const [, , shortNorthSouth, shortEastWestAtEquator] = GPC.cellDimensions(5);
const shortEastWest = shortEastWestAtEquator * narrowing;

const short = GPC.shorten(code);
const checked = GPC.withCheck(code, true);
const dms = GPC.toDMS(centreLatitude, centreLongitude);
const neighbours = neighboursOf(place);

const metres = (value: number) => `${value.toFixed(2)} m`;
const kilometres = (value: number) => `${(value / 1000).toFixed(1)} km`;
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);

/** A cell's size here, not at the equator: east-west narrows with latitude. */
const sizeHere = (level: number) => {
    const [, , ns, ewAtEquator] = GPC.cellDimensions(level);
    const worded = (m: number) => m >= 1000
        ? `${(m / 1000).toLocaleString('en', { maximumSignificantDigits: 3 })} km`
        : `${m.toLocaleString('en', { maximumSignificantDigits: 3 })} m`;
    return `${worded(ns)} by ${worded(ewAtEquator * narrowing)}`;
};

const COUNTED = ['none', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];

const whereItIs = where(place);
const today = spoken(place);
const saidAloud = `${place.name} ${short}`;
// Where the short form is understood: somewhere both people know the name.
const among = place.city ?? place.region ?? place.country;
const door = place.kind !== 'sight';
const title = `${whereItIs} · ${code}`;
const description = place.kind === 'featured'
    ? `The Grid Point Code for ${whereItIs} is ${code}, said aloud as ${saidAloud}. `
        + 'Every stall and door nearby has its own, found offline with no lookup.'
    : place.kind === 'city'
    ? `The Grid Point Code for ${whereItIs} is ${code}: ten characters for a `
        + `${metres(northSouth)} by ${metres(eastWest)} cell, decoded on any device `
        + 'with no network and no lookup.'
    : `The Grid Point Code for ${place.name}${place.near ? `, near ${place.near}` : ''}`
        + `${place.region ? `, ${place.region}` : ''}, ${place.country}, is ${code}: `
        + `ten characters for a ${metres(northSouth)} by ${metres(eastWest)} cell, `
        + 'decoded offline with no lookup.';

const canonical = new URL(`/play/${place.slug}`, Astro.site).href;
const wikipedia = place.wikipedia
    ? `https://en.wikipedia.org/wiki/${encodeURIComponent(place.wikipedia.replaceAll(' ', '_'))}`
    : null;
const wikidata = place.wikidata ? `https://www.wikidata.org/wiki/${place.wikidata}` : null;
const sameAs = [wikipedia, wikidata].filter(Boolean);
const playHere = `/play?c=${plain}`;

// Structured data, so a search engine can tell a place from a page about one.
const structured = [
    {
        '@context': 'https://schema.org',
        '@type': place.kind === 'city' ? 'City' : place.kind === 'sight' ? 'TouristAttraction' : 'Place',
        name: place.name,
        ...(place.description ? { description: sentence(place.description) } : {}),
        url: canonical,
        geo: { '@type': 'GeoCoordinates', latitude: centreLatitude, longitude: centreLongitude },
        address: {
            '@type': 'PostalAddress',
            ...(place.kind === 'city'
                ? { addressLocality: place.name }
                : place.city ? { addressLocality: place.city } : {}),
            ...(place.region ? { addressRegion: place.region } : {}),
            addressCountry: place.iso,
        },
        identifier: { '@type': 'PropertyValue', propertyID: 'Grid Point Code', value: code },
        ...(sameAs.length ? { sameAs } : {}),
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Play', item: new URL('/play', Astro.site).href },
            { '@type': 'ListItem', position: 2, name: place.name, item: canonical },
        ],
    },
];
// `<` escaped, so no string in the data can close the script element early.
const structuredJson = JSON.stringify(structured).replace(/</g, '\\u003c');
---

<Base title={title} description={description}>
    <script is:inline type="application/ld+json" set:html={structuredJson} />

    <div class="band">
        <div class="shell head">
            <p class="crumb"><a href="/play">Play</a></p>
            <h1>{place.name}</h1>
            <p class="where">
                {place.near && <span>near {place.near}</span>}
                {place.city && <span>{place.city}</span>}
                {place.region && place.region !== place.city && <span>{place.region}</span>}
                <span>{place.country}</span>
            </p>

            <div class="specimen">
                <CodeMark code={code} size="hero" label={`Grid Point Code for ${place.name}`} />
            </div>

            <dl class="lead">
                {place.kind === 'featured' && (
                    <div><dt>Without a code</dt><dd>{today}, and then directions</dd></div>
                )}
                <div><dt>With a code</dt><dd><code class="code">{code}</code></dd></div>
                <div>
                    <dt>Said aloud</dt>
                    <dd>{place.name}{' '}<code class="code">{short}</code></dd>
                </div>
            </dl>

            {place.kind === 'featured' && (
                <p class="honest">
                    This code is one spot in {place.name}, a cell {metres(northSouth)} by
                    {' '}{metres(eastWest)}. Every stall front and doorway in it has a code of
                    its own.
                </p>
            )}

            <p class="actions">
                <a class="primary" href={playHere}>
                    {door ? 'Get the code for your door' : 'Open in the playground'}
                </a>
            </p>
        </div>
    </div>

    <div class="shell body">
        <section aria-labelledby="what-it-says">
            <h2 id="what-it-says">What the code says</h2>
            <p>
                The Grid Point Code for {place.name} is <code class="code">{code}</code>. It
                names a cell {metres(northSouth)} north to south and {metres(eastWest)} east to
                west, centred on {dms}, and it turns back into that cell on any phone or
                computer by arithmetic alone: no network, no account, no lookup table.
            </p>
            {place.kind === 'city' && (
                <p>
                    The point used is the one GeoNames records for {place.name}, near its
                    centre{place.capital && place.name !== place.country
                        ? `, and ${place.name} is the capital of ${place.country}`
                        : ''}.
                </p>
            )}

            <dl class="facts">
                {place.description && (
                    <div><dt>What it is</dt><dd>{sentence(place.description)}</dd></div>
                )}
                <div><dt>Code</dt><dd><code class="code">{code}</code></dd></div>
                <div><dt>With a check character</dt><dd><code class="code">{checked}</code></dd></div>
                <div><dt>Short form</dt><dd><code class="code">{short}</code></dd></div>
                <div>
                    <dt>Cell centre</dt>
                    <dd><span class="code">{centreLatitude.toFixed(6)}, {centreLongitude.toFixed(6)}</span></dd>
                </div>
                <div><dt>Cell size</dt><dd>{metres(northSouth)} by {metres(eastWest)}</dd></div>
                {place.city && <div><dt>City</dt><dd>{place.city}</dd></div>}
                {place.region && <div><dt>Region</dt><dd>{place.region}</dd></div>}
                <div><dt>Country</dt><dd>{place.country}</dd></div>
                {place.population ? (
                    <div><dt>Population</dt><dd>{place.population.toLocaleString('en')}</dd></div>
                ) : null}
            </dl>
        </section>

        <section aria-labelledby="give">
            <h2 id="give">How to give this address</h2>
            <dl class="ways">
                <div>
                    <dt>On a sign, a form or a delivery note</dt>
                    <dd>
                        <p>
                            The whole code, <code class="code">{code}</code>. It needs nothing
                            else: no city, no street, no network to read it back.
                        </p>
                    </dd>
                </div>
                <div>
                    <dt>Said aloud, in {among}</dt>
                    <dd>
                        <p>
                            <strong>{saidAloud}</strong>: a name both people know, then the last
                            five characters. They give back the exact code for anywhere within
                            {' '}{kilometres(shortNorthSouth / 2)} north or south and
                            {' '}{kilometres(shortEastWest / 2)} east or west of {place.name}.
                            Further away the same five name somewhere else, which is why the
                            whole code is what goes on a sign.
                        </p>
                    </dd>
                </div>
                <div>
                    <dt>Copied by hand, or read over a phone</dt>
                    <dd>
                        <p>
                            <code class="code">{checked}</code>. The character on the end
                            catches any single mistyped symbol and any two neighbours swapped.
                        </p>
                    </dd>
                </div>
                <div>
                    <dt>As a link or a square code</dt>
                    <dd>
                        <p>
                            <a href={playHere}>Open it on the map</a>, move to the exact door,
                            and add directions if the code needs help: "blue gate, second
                            floor". The link and the square code carry them. Nothing is kept
                            on this site.
                        </p>
                    </dd>
                </div>
            </dl>
        </section>

        <section aria-labelledby="down">
            <h2 id="down">From the city to the door</h2>
            <p>
                The first {COUNTED[CITY_LEVEL]} characters name a cell about {sizeHere(CITY_LEVEL)} here.
                Each one after that picks one of 25 inside the last, so the whole ten name a
                spot about the size of a doorway.
            </p>
            <ol class="ladder">
                {levels.slice(CITY_LEVEL - 1).map(({ level, prefix, name }) => (
                    <li>
                        <span class="tint" data-level={level} aria-hidden="true">{prefix.at(-1)}</span>
                        <span class="prefix code">{prefix}</span>
                        <span class="what">{name}</span>
                        <span class="size code">{sizeHere(level)}</span>
                    </li>
                ))}
            </ol>
        </section>

        {neighbours.length > 0 && (
            <section aria-labelledby="more">
                <h2 id="more">More in {place.country}</h2>
                <ul class="more">
                    {neighbours.map((other) => (
                        <li><a href={`/play/${other.slug}`}>{other.name}</a></li>
                    ))}
                </ul>
            </section>
        )}

        <p class="credit">
            {place.kind !== 'city'
                ? <>Place and region from <a href={wikidata!} rel="noreferrer">Wikidata</a>{wikipedia ? <>, described on <a href={wikipedia} rel="noreferrer">Wikipedia</a></> : null}{place.city || place.near ? <>; {place.city ? 'city' : 'nearby town'} from <a href="https://www.geonames.org/" rel="noreferrer">GeoNames</a>, under CC BY 4.0</> : null}.</>
                : <>City, region and population from <a href="https://www.geonames.org/" rel="noreferrer">GeoNames</a>, under CC BY 4.0.</>}
        </p>
    </div>
</Base>

<style>
    .band {
        background: var(--surface);
        border-bottom: 1px solid var(--rule-soft);
    }

    .head {
        padding-block: var(--space-5);
    }

    .crumb {
        margin: 0 0 var(--space-2);
        font-size: var(--text-small-size);
    }

    h1 {
        margin: 0 0 var(--space-1);
    }

    .where {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin: 0 0 var(--space-4);
        color: var(--ink-mid);
    }

    /* A thin separator drawn by the layout, not typed into the text, so a
       screen reader reads three names rather than two dots. */
    .where span + span::before {
        content: '';
        display: inline-block;
        width: 4px;
        height: 4px;
        margin-right: var(--space-2);
        border-radius: 50%;
        background: var(--rule);
        vertical-align: middle;
    }

    .specimen {
        margin-bottom: var(--space-4);
    }

    /* Today's address, the code, and the code said aloud: three lines a reader
       compares, so they share one column of labels. */
    .lead {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: var(--space-1) var(--space-3);
        margin: 0 0 var(--space-3);
    }

    .lead div {
        display: contents;
    }

    .lead dt {
        color: var(--ink-soft);
    }

    .lead dd {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .honest {
        margin: 0 0 var(--space-4);
        color: var(--ink-mid);
        font-size: var(--text-small-size);
    }

    .ways {
        margin: var(--space-3) 0 0;
    }

    .ways div {
        border-top: 1px solid var(--rule-soft);
        padding-block: var(--space-2);
    }

    .ways dt {
        font-weight: 500;
    }

    .ways dd {
        margin: 0;
    }

    .ways p {
        margin: var(--space-1) 0 0;
    }

    .actions {
        margin: 0;
    }

    .primary {
        display: inline-block;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-card);
        background: var(--prussian);
        color: var(--surface);
        font-weight: 500;
        text-decoration: none;
    }

    .primary:hover {
        text-decoration: underline;
    }

    .body {
        padding-block: var(--space-4) var(--space-6);
    }

    h2 {
        margin: var(--space-5) 0 var(--space-2);
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        gap: var(--space-3) var(--space-4);
        margin: var(--space-4) 0 0;
    }

    .facts div {
        border-top: 1px solid var(--rule-soft);
        padding-top: var(--space-2);
    }

    .facts dt {
        font-size: var(--text-label-size);
        color: var(--ink-soft);
    }

    .facts dd {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .ladder {
        list-style: none;
        margin: var(--space-3) 0 0;
        padding: 0;
        max-width: 48rem;
    }

    .ladder li {
        display: grid;
        grid-template-columns: 2rem 8rem minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-1) 0;
        border-bottom: 1px solid var(--rule-soft);
    }

    .tint {
        display: grid;
        place-items: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: var(--radius-cell);
        font-family: var(--font-mono);
        font-weight: 600;
    }

    /* The same ten tints the home page ladder and the code mark use, so a level
       is one colour everywhere on the site. */
    .tint[data-level='1']  { background: var(--level-1);  color: var(--level-1-ink); }
    .tint[data-level='2']  { background: var(--level-2);  color: var(--level-2-ink); }
    .tint[data-level='3']  { background: var(--level-3);  color: var(--level-3-ink); }
    .tint[data-level='4']  { background: var(--level-4);  color: var(--level-4-ink); }
    .tint[data-level='5']  { background: var(--level-5);  color: var(--level-5-ink); }
    .tint[data-level='6']  { background: var(--level-6);  color: var(--level-6-ink); }
    .tint[data-level='7']  { background: var(--level-7);  color: var(--level-7-ink); }
    .tint[data-level='8']  { background: var(--level-8);  color: var(--level-8-ink); }
    .tint[data-level='9']  { background: var(--level-9);  color: var(--level-9-ink); }
    .tint[data-level='10'] { background: var(--level-10); color: var(--level-10-ink); }

    .size {
        color: var(--ink-mid);
        font-size: var(--text-small-size);
        white-space: nowrap;
    }

    .more {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-4);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .credit {
        margin-top: var(--space-5);
        font-size: var(--text-label-size);
        color: var(--ink-soft);
    }

    @media (max-width: 560px) {
        .lead {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }

        .lead div + div dt {
            margin-top: var(--space-2);
        }

        .ladder li {
            grid-template-columns: 2rem minmax(0, 1fr) auto;
        }

        .prefix {
            display: none;
        }
    }
</style>
