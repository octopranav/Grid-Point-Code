    .map {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 320ms ease-out;
        pointer-events: none;
    }

    /* Input is restored with the map. Without this the canvas is inert: no
       drag, no grab cursor, and Ctrl with the wheel falls through to the
       browser and zooms the page instead of the map. */
    .resolve[data-mapped='true'] .map {
        opacity: 1;
        pointer-events: auto;
    }

    /* Once the map is up it owns the stage, and the plate steps aside into the
