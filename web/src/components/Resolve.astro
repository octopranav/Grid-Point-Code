    .resolve[data-mapped='true'] .plate {
        inset: auto var(--space-2) var(--space-2) auto;
        width: 112px;
        padding: var(--space-2);
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius-card);
    }

    /* The key sits over the map, so it must not eat drags aimed at it. */
