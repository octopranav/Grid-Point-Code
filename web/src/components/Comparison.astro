---
// The one page that names other systems.
//
// Everywhere else in this project they are described by property rather than by
// name. Here they are named, because a resolution claim cannot be evaluated
// with nothing on the other side of it, and a reader who does not already know
// the field deserves the other side.
//
// The sourcing rules and the reason the losing dimensions are included live in
// lib/comparison.ts, beside the data they govern.

import { SYSTEMS, ROWS, PROMISES } from '../lib/comparison';

const ours = SYSTEMS[0];
---

<section class="compare">
    <header class="intro">
        <h1>Beside the alternatives</h1>
        <p class="lede">
            This is the only page here that names other systems. Everywhere else they
            are described by property, because this project is not a campaign against
            anything. But a claim like "twenty-two times finer" means nothing without
            the other side of it, so here is the other side.
        </p>
    </header>

    <ul class="promises">
        {PROMISES.map((promise) => <li>{promise}</li>)}
    </ul>

    <div class="table-scroll" tabindex="0">
        <table>
            <thead>
                <tr>
                    <!-- The corner of a comparison table heads nothing. A
                         header cell with no text is a header in name only, and
                         a screen reader announces it as one. -->
                    <td class="corner"></td>
                    {SYSTEMS.map((system) => (
                        <th scope="col" data-ours={system.id === ours.id}>
                            <span class="name">{system.name}</span>
                            <span class="kind">{system.kind}</span>
                        </th>
                    ))}
                </tr>
            </thead>
            <tbody>
                {ROWS.map((row) => (
                    <>
                        <tr>
                            <th scope="row">{row.dimension}</th>
                            {SYSTEMS.map((system) => (
                                <td data-ours={system.id === ours.id}>
                                    {row.values[system.id] ?? (
                                        <span class="unsaid">Its specification does not say</span>
                                    )}
                                </td>
                            ))}
                        </tr>
                        {row.note && (
                            <tr class="note-row">
                                <td colspan={SYSTEMS.length + 1}>{row.note}</td>
                            </tr>
                        )}
                    </>
                ))}
            </tbody>
        </table>
    </div>

    <h2>Where each figure came from</h2>
    <ul class="sources">
        {SYSTEMS.map((system) => (
            <li>
                <span class="who">{system.name}</span>
                <a href={system.source.url} rel={system.source.url.startsWith('http') ? 'noreferrer' : undefined}>
                    {system.source.label}
                </a>
            </li>
        ))}
    </ul>
    <p class="note quiet">
        Read on the dates this page was last built. If one of these systems has changed
        and this page has not, the fault is here and not there. The link beside each
        name is the thing to trust.
    </p>
</section>

<style>
    .compare {
        max-width: 72rem;
        margin: 0 auto;
        padding: var(--space-5) var(--space-4);
    }

    .intro {
        max-width: var(--measure);
    }

    h1 {
        margin: 0 0 var(--space-3);
    }

    h2 {
        margin: var(--space-5) 0 var(--space-2);
        padding-top: var(--space-3);
        border-top: 1px solid var(--rule-soft);
    }

    .compare p {
        margin: 0 0 var(--space-3);
        max-width: var(--measure);
    }

    /* The rules this page holds itself to, stated where a reader sees them
       before the table rather than in a footnote after it. */
    .promises {
        max-width: var(--measure);
        margin: 0 0 var(--space-4);
        padding-left: var(--space-4);
        color: var(--ink-mid);
        font-size: var(--text-small-size);
    }

    .promises li {
        margin-bottom: var(--space-1);
    }

    .table-scroll {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-small-size);
    }

    :where(th, td) {
        padding: var(--space-2);
        border-bottom: 1px solid var(--rule-soft);
        text-align: left;
        vertical-align: top;
    }

    thead th {
        border-bottom-color: var(--rule);
        vertical-align: bottom;
    }

    .name {
        display: block;
        font-family: var(--font-display);
        font-size: var(--text-title-size);
        font-weight: var(--text-title-weight);
        color: var(--ink);
    }

    .kind {
        display: block;
        font-family: var(--font-mono);
        font-size: var(--text-label-size);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-top: 2px;
    }

    tbody th {
        font-weight: 500;
        color: var(--ink-mid);
        min-width: 11rem;
    }

    /* Our own column is marked so a reader knows whose page they are on. It is
       not given a flattering colour: the point is disclosure, not emphasis. */
    [data-ours='true'] {
        background: var(--sunken);
    }

    .unsaid {
        color: var(--ink-soft);
        font-style: italic;
    }

    .note-row td {
        padding-top: 0;
        border-bottom: 1px solid var(--rule);
        color: var(--ink-mid);
        font-size: var(--text-label-size);
        line-height: 1.5;
    }

    .sources {
        list-style: none;
        margin: 0 0 var(--space-2);
        padding: 0;
    }

    .sources li {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        padding: var(--space-1) 0;
        border-bottom: 1px solid var(--rule-soft);
    }

    .who {
        min-width: 12rem;
        color: var(--ink-mid);
    }
</style>
