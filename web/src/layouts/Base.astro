---
// The shell every page sits in.

// Latin and Latin Extended only. The full families carry Cyrillic, Greek and
// Vietnamese too, which triples the number of files deployed for scripts this
// site never sets. The interface is English and the alphabet is Latin by
// construction. Anything outside these ranges falls back to the reader's own
// system font, which is the right answer for a name we did not typeset.
import '@fontsource/bitter/latin-600.css';
import '@fontsource/bitter/latin-ext-600.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';

import '../styles/global.css';

import tokens from '../../../design/tokens.json';

import Header from '../components/Header.astro';
import NetworkGate from '../components/NetworkGate.astro';
import Footer from '../components/Footer.astro';

const ground = {
    light: tokens.colour.light.ground,
    dark: tokens.colour.dark.ground,
};

interface Props {
    title: string;
    description: string;
    /**
     * A page that is a tool rather than a document: it takes the whole frame
     * below the masthead, scrolls nothing of its own, and goes without a footer.
     * A footer under a full-height instrument is a row of links nobody can see
     * without scrolling the instrument off the screen to reach them.
     */
    fills?: boolean;
}

const { title, description, fills = false } = Astro.props;

// Pages are written to disk as files rather than directories, so at build time
// this reads /index.html and /play.html rather than / and /play. The address a
// visitor sees has neither suffix, and it is that address a canonical link and
// a title have to agree with.
const route = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');

// A page title reads best as its own name first and the project second; the
// front door is the one place that wants the order reversed.
const isHome = route === '/';
const fullTitle = isHome ? 'Grid Point Code' : `${title} · Grid Point Code`;
const canonical = new URL(route, Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />

        <!-- The mark reduced to four level tints. SVG for anything modern; the
             PNGs are for the home screen, where they are masked to whatever
             shape the platform prefers. -->
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- The browser's own chrome, painted the same colour as the page under
             it. Both are declared because a phone in dark mode with a pale bar
             above the page looks like a rendering fault. -->
        <meta name="theme-color" content={ground.light} media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content={ground.dark} media="(prefers-color-scheme: dark)" />

        <!-- Runs before the first paint. Reading the stored choice after the
             page has drawn would show the wrong theme and then correct it,
             which is worse than either theme. It is deliberately inline and
             deliberately not a module: both would defer it past paint. -->
        <script is:inline>
            (function () {
                var root = document.documentElement;
                var choice = 'system';
                try {
                    var stored = localStorage.getItem('gpc-theme');
                    if (stored === 'light' || stored === 'dark') choice = stored;
                } catch (error) {
                    /* a blocked store just means the system setting wins */
                }
                root.dataset.themeChoice = choice;
                if (choice !== 'system') root.dataset.theme = choice;
            })();
        </script>
    </head>

    <body data-fills={fills ? 'true' : undefined}>
        <a class="skip-link" href="#main">Skip to content</a>
        <Header />
        <main id="main" data-fills={fills ? 'true' : undefined}>
            <slot />
        </main>
        {!fills && <Footer />}
        <NetworkGate />

        <script>
            // Registered after load, and never awaited: the site is arithmetic
            // and works without it. All this buys is the same site with the
            // network cut -- which for a format whose whole claim is that a
            // code needs no lookup seems the least it should manage.
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker
                        .register(import.meta.env.BASE_URL + 'sw.js')
                        .catch(() => {
                            /* refused registration costs only the offline copy */
                        });
                });
            }
        </script>
    </body>
</html>

<style is:global>
    /* A filling page owns everything below the masthead.

       The body carries a DEFINITE height here, not the usual `min-height`. That
       distinction is the whole thing: a minimum constrains nothing, so when the
       tool's content grew the body grew with it, and `flex: 1` then handed the
       main element MORE than the viewport's leftover rather than less. The page
       scrolled and took the map with it -- which is the fault this mode exists
       to prevent.

       `min-height: 0` is the other half: a flex child will not shrink below its
       content without it, so the panel inside could not scroll on its own. */
    body[data-fills] {
        height: 100vh;
        overflow: hidden;
    }

    main[data-fills] {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    /* Too little height to divide on a phone, so it goes back to a page that
       scrolls normally and the tool takes a fixed slice of it. */
    @media (max-width: 900px) {
        body[data-fills] { height: auto; overflow: visible; }
        main[data-fills] { display: block; overflow: visible; }
    }
</style>
