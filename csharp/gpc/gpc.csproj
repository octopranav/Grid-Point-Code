<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Ca.Pranavpatel.Algo.GridPointCode</AssemblyName>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>
  
  <!-- NuGet Package info -->
  <PropertyGroup>
    <PackageId>Ca.Pranavpatel.Algo.GridPointCode</PackageId>
    <PackageVersion>1.1.0</PackageVersion>
    <Description>Grid Point Code (GPC) is a global geocoding system that gives any location a compact 11-character alphanumeric code. Encoding and decoding run offline, with no network or API, and round-trip exactly at the code's fixed precision of five decimal places of latitude and longitude.</Description>
    <Authors>Pranavkumar Patel</Authors>
    <PackageProjectUrl>https://github.com/octopranav/Grid-Point-Code</PackageProjectUrl>
    <RepositoryUrl>https://github.com/octopranav/Grid-Point-Code.git</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2017 © Pranavkumar Patel. All rights reserved.</Copyright>
    <PackageTags>encoding;offline;geocoding;mapping;location;geospatial;address;gis;decoding;latitude;longitude;coordinates;unique-identifier;precision;gpc;geographic;grid-point-code;global-code</PackageTags>
    <Title>Grid Point Code (GPC)</Title>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
