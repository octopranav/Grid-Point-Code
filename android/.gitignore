# Everything Gradle and the Android build write. None of it is source.
.gradle/
.kotlin/
build/
.cxx/
captures/
local.properties
*.apk
*.aab

# A signing key never belongs in a public repository, not even by accident.
*.jks
*.keystore

# The root ignore file is written for .NET, where folders called debug and
# release are build output. Here they are the source sets for debug and release
# builds, so they come back: the release's holds its baseline profile.
!**/src/debug/
!**/src/release/
