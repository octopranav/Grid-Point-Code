<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds only. A build made with -Pgpc.styles pointing at the
         emulator's host can read a local copy of the map over plain HTTP.
         Nothing else is allowed in the clear, and release builds carry no
         exception at all. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
